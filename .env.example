# Copy to .env for local development. Nothing here is a secret except where noted.

# Public origin of the site, used for the sitemap, robots and metadata.
# NEXT_PUBLIC_SITE_URL="https://jenkinsdetailing.com"

# Quote requests. Without RESEND_API_KEY the form logs to the server console instead
# of sending, so local development needs no key.
# RESEND_API_KEY="re_..."                                   (secret)
# ENQUIRY_FROM="Jenkins Detailing <quotes@jenkinsdetailing.com>"
# ENQUIRY_TO="info@jenkinsdetailing.com"

# Cloudflare Turnstile. Without the keys the anti-spam check is skipped.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAA..."
# TURNSTILE_SECRET_KEY="0x4AAA..."                          (secret)

# CMS (see docs/cms.md)
# CMS_REPO="owner/jenkins-detailing"
# CMS_AUTH_URL="https://jenkins-detailing-cms-auth.example.workers.dev"
