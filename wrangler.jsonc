{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jenkins-detailing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Custom domains: Cloudflare creates the DNS records on deploy (the zone must be in this account).
  "routes": [
    { "pattern": "jenkinsdetailing.com", "custom_domain": true },
    { "pattern": "www.jenkinsdetailing.com", "custom_domain": true }
  ],
  // Keep the workers.dev address alive so old links land, then the middleware sends them to the apex.
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "env": {
    // `opennextjs-cloudflare deploy --env preview`: a separate jenkins-detailing-preview Worker on
    // workers.dev only, for the client to review before a release. No custom domains; the
    // middleware serves its address in place (no redirect to the apex) and marks it noindex.
    "preview": {
      "routes": [],
      "workers_dev": true,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      }
    }
  }
}
